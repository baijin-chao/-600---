# 复制为 .env 后填写，docker compose 会自动读取
# 注意：.env 已在 .gitignore 中，不会被提交

# LiveGBS 平台地址，结尾不要带斜杠
LIVEGBS_BASE_URL=http://192.168.1.10:10000

# 平台账号
LIVEGBS_USERNAME=admin

# 32 位大写 MD5，例如：
#   Linux/macOS: printf '%s' 'your-password' | md5sum | awk '{print toupper($1)}'
#   PowerShell:  [BitConverter]::ToString([Security.Cryptography.MD5]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes('your-password'))).Replace('-','')
LIVEGBS_PASSWORD=0123456789ABCDEF0123456789ABCDEF

# 写接口鉴权 token，留空则不校验（不建议）
CAMERA_STATUS_ADMIN_TOKEN=change-me

# 并发参数，按平台承受能力调
CAMERA_STATUS_THREADS=64
CAMERA_STATUS_MAX_CONCURRENCY=32

# 定时周期，"-" 表示关闭定时任务
CAMERA_STATUS_CRON=0 0/10 * * * ?
